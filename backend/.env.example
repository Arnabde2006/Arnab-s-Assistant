PORT=5000
DATABASE_URL=your_neon_connection_string
JWT_SECRET=replace_with_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# Max Postgres connections in the pool. Keep modest for Neon serverless (default 10).
PG_POOL_MAX=10

# Comma-separated model lists — update here when providers retire models, no code change needed.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

GROQ_API_KEY=your_groq_api_key
# Vision-capable Groq models — PDF pages are converted to images before sending
GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct,qwen/qwen3.6-27b
# Text-only Groq models — NEVER used when images are in the request
GROQ_TEXT_MODELS=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your_openrouter_api_key
# OpenRouter vision and text model lists — max_tokens capped at 2048 to stay within free credits
OPENROUTER_VISION_MODELS=google/gemini-2.0-flash,google/gemini-2.0-flash-lite
OPENROUTER_TEXT_MODELS=google/gemini-2.0-flash,meta-llama/llama-3.3-70b-instruct

# AI request timeouts (milliseconds).
# AI_REQUEST_TIMEOUT_MS   — hard cap on a full non-streaming AI call before it aborts (default 45000).
# AI_STREAM_IDLE_TIMEOUT_MS — for streaming calls, aborts if no chunk arrives for this long (default 30000).
AI_REQUEST_TIMEOUT_MS=45000
AI_STREAM_IDLE_TIMEOUT_MS=30000
